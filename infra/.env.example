# Local development defaults only. Never reuse these credentials in staging.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-development-secret-change-me

# Keep the image pinned so upgrades are deliberate and reproducible.
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.1

# Added to livekit.yaml only when a webhook receiver is available.
LIVEKIT_WEBHOOK_URL=
