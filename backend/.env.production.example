ENVIRONMENT=production

# Telegram BotFather token. Run exactly one polling bot replica.
BOT_TOKEN=replace-me

# Used by compose.production.yaml to initialize PostgreSQL and build DATABASE_URL.
POSTGRES_DB=telegram_voice
POSTGRES_USER=telegram_voice
# Use URL-safe characters because Compose builds DATABASE_URL from this value.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

FRONTEND_PUBLIC_URL=https://voice.example.ru
BACKEND_PUBLIC_URL=https://api.example.ru
ALLOWED_ORIGINS=https://voice.example.ru
ALLOWED_HOSTS=api.example.ru,localhost,127.0.0.1
BACKEND_BIND_IP=127.0.0.1

# Generate with: openssl rand -hex 32
JOIN_TOKEN_SECRET=replace-with-at-least-32-random-characters
JOIN_TOKEN_TTL_SECONDS=900

# Provisioned by the separate LiveKit/voice-infrastructure component.
LIVEKIT_URL=wss://rtc.example.ru
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Optional immutable registry tag for deploy/rollback.
BACKEND_IMAGE=telegram-voice-backend:local
